<Window x:Class="ASID.Edge.Views.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock
            Text="PRINT PREVIEW"
            FontSize="20"
            FontWeight="Bold"
            HorizontalAlignment="Center"/>

        <Border Grid.Row="1"
                Margin="0,20"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">

            <Image Name="dmImage" Width="600" Height="400" Stretch="Uniform" Margin="1" />

            <!--<StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center" Width="360">

                <TextBlock
                    Text="Generated Data Matrix"
                    FontWeight="Bold"
                    FontSize="16"
                    Margin="0,15"/>

                <TextBlock
                    x:Name="txtDataMatrix"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="DarkBlue"
                    Margin="20" Height="31"/>

            </StackPanel>-->

        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <Button
                Width="100"
                Height="35"
                Margin="10"
                Content="Print"
                Click="Print_Click"/>

            <Button
                Width="100"
                Height="35"
                Margin="10"
                Content="Cancel"
                Click="Cancel_Click"/>

        </StackPanel>

    </Grid>

</Window>