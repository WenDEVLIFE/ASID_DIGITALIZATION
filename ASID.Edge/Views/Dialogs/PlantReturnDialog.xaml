<Window x:Class="ASID.Edge.Views.Dialogs.PlantReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant Return"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">

        <!-- ================= PHASE 1 : LOGIN ================= -->
        <StackPanel x:Name="Phase1Panel">
            <TextBlock Text="&#x1F512; Plant Return — Authorization"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#B8860B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Sign in to authorize this plant return (any valid account)."
                       FontSize="13"
                       Foreground="#666666"
                       TextAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameTextBox"
                     Height="38"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     KeyDown="UsernameTextBox_KeyDown"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="38"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,8"
                         KeyDown="PasswordInput_KeyDown"/>

            <TextBlock x:Name="LoginErrorText"
                       Foreground="#D32F2F"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <DockPanel Margin="0,4,0,0">
                <Button Content="Cancel"
                        Width="90"
                        Height="34"
                        DockPanel.Dock="Left"
                        IsCancel="True"
                        Click="Cancel_Click"/>

                <Button Content="Login"
                        Width="120"
                        Height="34"
                        Background="#B8860B"
                        Foreground="White"
                        FontWeight="Bold"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="Login_Click"/>
            </DockPanel>
        </StackPanel>

        <!-- ================= PHASE 2 : RETURN INPUT ================= -->
        <StackPanel x:Name="Phase2Panel" Visibility="Collapsed">
            <TextBlock Text="PLANT RETURN"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#B8860B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Part No." FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="PartNoTextBox"
                     Height="38"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     KeyDown="PartNoTextBox_KeyDown"/>

            <TextBlock Text="Qty:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="QtyTextBox"
                     Height="38"
                     FontSize="16"
                     Text="1"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     PreviewTextInput="QtyTextBox_PreviewTextInput"
                     KeyDown="QtyTextBox_KeyDown"/>

            <TextBlock Text="Remarks:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="RemarksTextBox"
                     Height="38"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,8"/>

            <TextBlock x:Name="InputErrorText"
                       Foreground="#D32F2F"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <DockPanel Margin="0,4,0,0">
                <Button Content="Cancel"
                        Width="90"
                        Height="34"
                        DockPanel.Dock="Left"
                        Click="Cancel_Click"/>

                <Button Content="SAVE"
                        Width="120"
                        Height="34"
                        Background="#B8860B"
                        Foreground="White"
                        FontWeight="Bold"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="Save_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
