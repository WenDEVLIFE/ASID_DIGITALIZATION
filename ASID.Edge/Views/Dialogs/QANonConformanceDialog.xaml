<Window x:Class="ASID.Edge.Views.Dialogs.QANonConformanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA NC Approval / Review"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="QA NC REVIEW &amp; APPROVAL"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#0B3A66"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Margin="0,15,0,10"
                   Text="Scan or enter the Data Matrix of the Suspected NC item:"
                   FontSize="13"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBox x:Name="txtDataMatrix"
                     Height="40"
                     FontSize="18"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Cancel"
                    Width="80"
                    Height="34"
                    DockPanel.Dock="Left"
                    Click="Cancel_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Reject NC"
                        Width="110"
                        Height="34"
                        Margin="0,0,10,0"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="RejectNC_Click"/>

                <Button Content="Confirm NC"
                        Width="110"
                        Height="34"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ConfirmNC_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
