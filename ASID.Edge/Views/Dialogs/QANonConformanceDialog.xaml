<Window x:Class="ASID.Edge.Views.Dialogs.QANonConformanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA NC Review"
        Width="520"
        Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="QA NC REVIEW"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#0B3A66"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Margin="0,15,0,10"
                   Text="Scan or enter the Data Matrix of the Suspected NC item:"
                   FontSize="13"/>

        <TextBox x:Name="txtDataMatrix"
                 Grid.Row="2"
                 Height="40"
                 FontSize="18"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,10"/>

        <!-- Scrap quantity (only visible when Scrap is selected) -->
        <StackPanel x:Name="ScrapQtyPanel"
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="Scrap Quantity:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtScrapQuantity"
                     Height="38"
                     FontSize="16"
                     Text="1"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,15,0,0">
            <Button Content="Cancel"
                    Width="80"
                    Height="34"
                    DockPanel.Dock="Left"
                    Click="Cancel_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnUnflag"
                        Content="✓ Unflag (OK)"
                        Width="130"
                        Height="34"
                        Margin="0,0,10,0"
                        Background="#2E7D32"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Unflag_Click"/>

                <Button x:Name="BtnScrap"
                        Content="✗ Scrap (NG)"
                        Width="130"
                        Height="34"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="Scrap_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
