<Window x:Class="ASID.Edge.Views.Dialogs.LaneBarcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lane Barcode"
        Height="280"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Lane Barcode"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#0B3A66"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Barcode Display -->
        <Border Grid.Row="1"
                BorderBrush="#CCC"
                BorderThickness="1"
                Padding="15"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="imgBarcode"
                       Width="300" Height="100"
                       Stretch="Uniform"/>
                <TextBlock x:Name="txtLaneCode"
                           Text="A-01"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Instructions -->
        <TextBlock Grid.Row="2"
                   x:Name="txtInstruction"
                   Text="Scan the barcode to store the lane number."
                   FontSize="11" FontStyle="Italic"
                   Foreground="#666"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,30,0,0">
            <Button x:Name="btnConfirm"
                    Content="OK"
                    Width="80" Height="30"
                    Background="#0B3A66"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
