<Window x:Class="ASID.Edge.Views.Dialogs.TransactionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Transaction"
        Width="540" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" CornerRadius="8" Padding="15,12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="EDIT TRANSACTION" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Supervisor correction of transaction details."
                           Foreground="#AED6F1" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Read-only: Data Matrix -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Data Matrix:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDataMatrix" Height="28" Margin="0,0,0,10"
                         IsReadOnly="True" Background="#ECECEC" VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Read-only: Status -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtStatus" Height="28" Margin="0,0,0,10"
                         IsReadOnly="True" Background="#ECECEC" VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Model -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtModel" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Part No -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Part No:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtPartNo" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Serial No -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Serial No:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtSerialNo" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- SNP -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="SNP:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtSNP" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Operator -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Operator:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtOperator" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Line No -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Line No:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtLineNo" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Trolley No -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Trolley No:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtTrolleyNo" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Lane No -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Lane No:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtLaneNo" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- Date -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Date:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <DatePicker Grid.Row="10" Grid.Column="1" x:Name="dpDate" Height="28" Margin="0,0,0,10"
                            VerticalContentAlignment="Center"/>

                <!-- Time -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Time (HH:mm:ss):" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="11" Grid.Column="1" x:Name="txtTime" Height="28" Margin="0,0,0,10"
                         VerticalContentAlignment="Center" Padding="5,2"/>

                <!-- NC note -->
                <Border Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,5,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7A5B00"
                               Text="NC remarks are managed by the QC flow (Suspected NC / QA Review NC) and cannot be edited here."/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Error + Buttons -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="txtError" Foreground="#C62828" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="btnSave" Content="💾 Save" Width="110" Height="34"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Click="BtnSave_Click" Margin="5" Cursor="Hand"/>
                <Button x:Name="btnCancel" Content="❌ Cancel" Width="110" Height="34"
                        Background="#95A5A6" Foreground="White" FontWeight="Bold"
                        Click="BtnCancel_Click" Margin="5" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
