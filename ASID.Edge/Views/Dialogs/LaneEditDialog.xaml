<Window x:Class="ASID.Edge.Views.Dialogs.LaneEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Lane"
        Width="420" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" CornerRadius="8" Padding="15,12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="EDIT LANE" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="txtLaneNo" Text="" Foreground="#AED6F1" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Part Number -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Part Number:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPartNo" Height="28" Margin="0,0,0,10"
                     VerticalContentAlignment="Center" Padding="5,2"/>

            <!-- Max Trolleys -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Trolleys:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMaxQty" Height="28" Margin="0,0,0,10"
                     VerticalContentAlignment="Center" Padding="5,2"/>

            <!-- Stored (Scans) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Stored (Scans):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtStoredQty" Height="28" Margin="0,0,0,10"
                     VerticalContentAlignment="Center" Padding="5,2"/>

            <!-- Withdrawn -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Withdrawn:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtWithdrawnQty" Height="28" Margin="0,0,0,10"
                     VerticalContentAlignment="Center" Padding="5,2"/>

            <!-- Balance (auto-calculated) -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance:" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtBalance" Text="0" FontWeight="Bold" FontSize="14"
                       Foreground="#2C3E50" VerticalAlignment="Center" Margin="5,0,0,10"/>

            <!-- Status (auto-calculated) -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtStatus" Text="Not Assigned" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" Margin="5,0,0,10"/>

            <!-- Color -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Color:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <Border x:Name="borderColor" Grid.Row="6" Grid.Column="1" Width="60" Height="24" CornerRadius="4"
                    Background="Gray" VerticalAlignment="Center" Margin="5,0,0,10">
                <TextBlock x:Name="txtColor" Text="Gray" Foreground="White" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnSave" Content="💾 Save" Width="110" Height="34"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click" Margin="5" Cursor="Hand"/>
            <Button x:Name="btnCancel" Content="❌ Cancel" Width="110" Height="34"
                    Background="#95A5A6" Foreground="White" FontWeight="Bold"
                    Click="BtnCancel_Click" Margin="5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
