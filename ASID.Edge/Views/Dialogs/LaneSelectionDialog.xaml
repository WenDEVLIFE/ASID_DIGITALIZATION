<Window x:Class="ASID.Edge.Views.Dialogs.LaneSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lane Selection"
        Width="520"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="LANE SELECTION"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#0B3A66"
                   HorizontalAlignment="Center"/>

        <!-- Instruction -->
        <TextBlock Grid.Row="1"
                   Margin="0,20,0,10"
                   Text="Scan a lane number from the vacant list below."
                   TextAlignment="Center"
                   FontSize="15"/>

        <!-- Vacant lanes label -->
        <TextBlock Grid.Row="2"
                   Text="Vacant Lanes"
                   FontWeight="SemiBold"/>

        <!-- Vacant lanes list -->
        <ListBox x:Name="VacantLanesList"
                 Grid.Row="3"
                 Margin="0,5,0,15"
                 FontSize="18"
                 HorizontalContentAlignment="Center"/>

        <!-- Label -->
        <TextBlock Grid.Row="4"
                   Text="Scan Lane Number"
                   FontWeight="SemiBold"/>

        <!-- Scan TextBox -->
        <TextBox x:Name="LaneTextBox"
                 Grid.Row="5"
                 Height="42"
                 FontSize="20"
                 VerticalContentAlignment="Center"
                 KeyDown="LaneTextBox_KeyDown"/>

        <!-- Rejection message -->
        <TextBlock x:Name="RejectionText"
                   Grid.Row="6"
                   Margin="0,10,0,0"
                   Foreground="#B71C1C"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Bottom -->
        <DockPanel Grid.Row="7"
                   Margin="0,20,0,0">

            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Text="Only vacant lanes are accepted."/>

            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="Cancel_Click"/>
        </DockPanel>

    </Grid>

</Window>