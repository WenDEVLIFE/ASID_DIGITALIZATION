<Window x:Class="ASID.Edge.Views.Dialogs.NonConformanceScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Non-Conformance / NC Items"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="NC / SCRAP ITEM REPORT"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#B71C1C"
                   HorizontalAlignment="Center"/>

        <!-- Instruction -->
        <TextBlock Grid.Row="1"
                   Margin="0,15,0,10"
                   Text="Scan the Data Matrix as per trolley and enter NC/SCRAP quantity."
                   TextAlignment="Center"
                   FontSize="13"/>

        <!-- Inputs Grid -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Data Matrix Label & Input -->
            <TextBlock Grid.Row="0" Text="Data Matrix" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="DataMatrixTextBox"
                     Grid.Row="1"
                     Height="38"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     KeyDown="DataMatrixTextBox_KeyDown"/>

            <!-- Quantity Label & Input -->
            <TextBlock Grid.Row="2" Text="Number of NC / SCRAP items" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNCQuantity"
                     Grid.Row="3"
                     Height="38"
                     FontSize="16"
                     Text="1"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Bottom Controls -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    DockPanel.Dock="Left"
                    Click="Cancel_Click"/>

            <Button Content="Submit NC"
                    Width="120"
                    Height="34"
                    Background="#B71C1C"
                    Foreground="White"
                    FontWeight="Bold"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Click="Submit_Click"/>
        </DockPanel>
    </Grid>
</Window>