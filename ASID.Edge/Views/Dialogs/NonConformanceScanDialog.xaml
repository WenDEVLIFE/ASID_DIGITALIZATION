<Window x:Class="ASID.Edge.Views.Dialogs.NonConformanceScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Non-Conformance"
        Width="500"
        Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="NON-CONFORMANCE REPORT"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#B71C1C"
                   HorizontalAlignment="Center"/>

        <!-- Instruction -->
        <TextBlock Grid.Row="1"
                   Margin="0,20,0,10"
                   Text="Scan the Data Matrix of the suspected material."
                   TextAlignment="Center"
                   FontSize="15"/>

        <!-- Label -->
        <TextBlock Grid.Row="2"
                   Text="Data Matrix"
                   FontWeight="SemiBold"/>

        <!-- Scan TextBox -->
        <TextBox x:Name="DataMatrixTextBox"
                 Grid.Row="3"
                 Height="42"
                 FontSize="20"
                 VerticalContentAlignment="Center"
                 KeyDown="DataMatrixTextBox_KeyDown"/>

        <!-- Bottom -->
        <DockPanel Grid.Row="4"
                   Margin="0,20,0,0">

            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Text="The dialog closes automatically after a successful scan."/>

            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="Cancel_Click"/>
        </DockPanel>

    </Grid>

</Window>