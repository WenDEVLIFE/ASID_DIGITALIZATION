<UserControl x:Class="ASID.Edge.Views.Controls.InventoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ASID.Edge.Views.Controls"
             mc:Ignorable="d" 
              d:DesignHeight="600"
             d:DesignWidth="900"
             d:Background="LightGray">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Sort -->
            <RowDefinition Height="*"/>
            <!-- Table -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <TextBlock Grid.Row="0"
                   Text="PU-BODY INVENTORY"
                   Background="#0B3A66"
                   Foreground="White"
                   Padding="8"
                   FontWeight="Bold"
                   TextAlignment="Center"/>

        <!-- ================= SORT BUTTON ================= -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="5">

            <Button Click="SortByModel"
                    Margin="5"
                    Padding="10,5"
                    Background="#E0E0E0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Cursor="Hand">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Model" Margin="0,0,5,0"/>
                    <TextBlock Text="▲▼"/>
                </StackPanel>

            </Button>

        </StackPanel>

        <!-- ================= DATA GRID ================= -->
        <DataGrid x:Name="MyDataGrid"
                  Grid.Row="2"
                  Margin="5"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  d:ItemsSource="{d:SampleData ItemCount=10}"

                  RowBackground="White"
                  AlternatingRowBackground="#EAEAEA"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Model Name" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Part No" Binding="{Binding PartNo}" Width="*"/>
                <DataGridTextColumn Header="P2 Supermarket" Binding="{Binding InventoryByLocation_PUBodySupermarket}" Width="*"/>
                <DataGridTextColumn Header="Floating" Binding="{Binding InventoryFloating}" Width="*"/>
                <DataGridTextColumn Header="P2 Loading Bay" Binding="{Binding InventoryByLocation_P2LoadingBay}" Width="*"/>
                <DataGridTextColumn Header="P1 Loading Bay" Binding="{Binding InventoryByLocation_P1LoadingBay}" Width="*"/>
                <DataGridTextColumn Header="P1 Production" Binding="{Binding InventoryByLocation_P1Production}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>