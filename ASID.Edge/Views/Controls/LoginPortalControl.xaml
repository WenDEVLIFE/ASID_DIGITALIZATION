<UserControl x:Class="ASID.Edge.Views.Controls.LoginPortalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ASID.Edge.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="250"
             d:DesignWidth="300"
             d:Background="LightGray">
    <Grid>
        <!-- ================= LOGIN PORTAL ================= -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="PU SUPERMARKET LOG-IN PORTAL"
                      Background="#0B3A66"
                      Foreground="White"
                      FontWeight="Bold"
                      Padding="8"
                      TextAlignment="Center"/>

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step 1: Kanban -->
                <Button x:Name="btnKanbanLabel"
                        Content="1. Kanban"
                       Grid.Row="0"
                       Grid.Column="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtKanban"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        IsReadOnly="True"/>

                <!-- Step 2: Lane -->
                <Button x:Name="btnLaneLabel"
                        Content="2. Lane No."
                       Grid.Row="1"
                       Grid.Column="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtLane"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        IsReadOnly="True"/>

                <!-- Step 3: Trolley -->
                <Button x:Name="btnTrolleyLabel"
                        Content="3. Trolley No."
                       Grid.Row="2"
                       Grid.Column="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtTrolley"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"/>

                <!-- Step 4: Cell -->
                <Button x:Name="btnLineLabel"
                        Content="4. Cell No."
                       Grid.Row="3"
                       Grid.Column="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtLine"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"/>

                <!-- Step 5: Operator -->
                <Button x:Name="btnOperatorLabel"
                        Content="5. Operator"
                       Grid.Row="4"
                       Grid.Column="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtOperator"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="4"
                        Grid.Column="1"
                        Margin="5"/>

                <!-- Verification -->

            <StackPanel x:Name="VerificationPanel"
                Grid.Row="5"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Margin="5">

                        <TextBlock
                Text="Verification Scan"
                FontWeight="Bold"/>

                        <TextBlock
                x:Name="txtVerificationPrompt"
                Margin="0,5,0,5"
                Foreground="DarkBlue"
                FontWeight="SemiBold"/>

                        <TextBox
                x:Name="txtVerification"
                KeyDown="Verification_KeyDown"/>

            </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">

                    <Button x:Name="btnApply"
                    Content="Apply Changes"
                    Width="100"
                    Margin="5"
                    Click="Apply_Click"/>

                    <Button x:Name="btnPrint"
                    Content="Print"
                    Width="70"
                    Margin="5"
                    IsEnabled="False"
                    Click="Print_Click"/>

                    <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="70"
                    Margin="5"
                    Click="Cancel_Click"/>

                </StackPanel>

            </Grid>

        </StackPanel>

    </Grid>
</UserControl>
