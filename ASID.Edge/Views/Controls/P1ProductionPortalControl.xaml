<UserControl x:Class="ASID.Edge.Views.Controls.P1ProductionPortalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ASID.Edge.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="250"
             d:DesignWidth="300"
             d:Background="LightGray">
    <Grid>
        <!-- ================= Withdrawal Station ================= -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="P1 PRODUCTION STATION"
                      Background="#0B3A66"
                      Foreground="White"
                      FontWeight="Bold"
                      Padding="8"
                      TextAlignment="Center"/>

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Label -->
                <Button x:Name="btnScanDMLabel"
                        Content="Scan Data Matrix"
                       Grid.Row="0"
                       Margin="5"
                       Background="#0B3A66"
                       Foreground="White"/>

                <TextBox x:Name="txtDataMatrix"
                         KeyDown="Scan_KeyDown"
                         Grid.Row="1"
                         Margin="5,5,5,-158"
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" 
                         Grid.RowSpan="3"/>

            </Grid>

        </StackPanel>

    </Grid>
</UserControl>
