<UserControl x:Class="ASID.Edge.Views.Controls.WorkflowStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="Gray"
            BorderThickness="1"
            Padding="10"
            Margin="5">

        <StackPanel>

            <TextBlock x:Name="TitleText"
                       Text="READY"
                       FontWeight="Bold"
                       FontSize="18"/>

            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,15"
                       Text="Please Scan Operator ID"/>

            <Separator/>

            <TextBlock Text="Scanner : Connected"/>

            <TextBlock Text="Printer : Ready"/>

            <TextBlock Text="API : Connected"/>

            <TextBlock Text="Database : Connected"/>

        </StackPanel>

    </Border>

</UserControl>