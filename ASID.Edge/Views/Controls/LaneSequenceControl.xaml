<UserControl x:Class="ASID.Edge.Views.Controls.LaneSequenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="300">
    <Border BorderBrush="Black" BorderThickness="1.5" Background="White" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0088CC" Padding="8,5" Margin="0,0,0,10" HorizontalAlignment="Left">
                <TextBlock Text="LANE SEQUENCE:" Foreground="White" FontWeight="Bold" FontSize="14"/>
            </Border>

            <!-- Sequence Layout -->
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column A -->
                    <StackPanel Grid.Column="0" Margin="5">
                        <!-- Lane A1 (FULL) -->
                        <Grid Margin="0,0,0,5">
                            <Button x:Name="btnLaneA1" 
                                    Content="Lane A1" 
                                    Background="Red" 
                                    Foreground="White" 
                                    FontWeight="Bold" 
                                    Height="32"
                                    BorderBrush="DarkRed"
                                    BorderThickness="1"/>
                            <Border Background="White" BorderBrush="Black" BorderThickness="1" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    Margin="0,-8,-15,0" Padding="4,1">
                                <TextBlock Text="FULL" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                        </Grid>

                        <!-- Lane A2 -->
                        <Button x:Name="btnLaneA2" 
                                Content="Lane A2" 
                                Background="White" 
                                Foreground="Black" 
                                FontWeight="Bold" 
                                Height="32" 
                                Margin="0,5"
                                BorderBrush="Orange" 
                                BorderThickness="1.5"
                                Click="Lane_Click"/>

                        <!-- Down Arrow A -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,15">
                            <Polygon Points="0,0 10,0 5,20 0,0" Fill="White" Stroke="LightSkyBlue" StrokeThickness="2" Stretch="Uniform" Height="50" Width="18"/>
                        </StackPanel>

                        <!-- Lane A40 -->
                        <Button x:Name="btnLaneA40" 
                                Content="Lane A40" 
                                Background="White" 
                                Foreground="Black" 
                                FontWeight="Bold" 
                                Height="32"
                                BorderBrush="Orange" 
                                BorderThickness="1.5"
                                Click="Lane_Click"/>
                    </StackPanel>

                    <!-- Column B -->
                    <StackPanel Grid.Column="1" Margin="5">
                        <!-- Lane B1 -->
                        <Button x:Name="btnLaneB1" 
                                Content="Lane B1" 
                                Background="White" 
                                Foreground="Black" 
                                FontWeight="Bold" 
                                Height="32" 
                                Margin="0,0,0,5"
                                BorderBrush="Green" 
                                BorderThickness="1.5"
                                Click="Lane_Click"/>

                        <!-- Lane B2 -->
                        <Button x:Name="btnLaneB2" 
                                Content="Lane B2" 
                                Background="White" 
                                Foreground="Black" 
                                FontWeight="Bold" 
                                Height="32" 
                                Margin="0,5"
                                BorderBrush="Green" 
                                BorderThickness="1.5"
                                Click="Lane_Click"/>

                        <!-- Down Arrow B -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,15">
                            <Polygon Points="0,0 10,0 5,20 0,0" Fill="White" Stroke="LightSkyBlue" StrokeThickness="2" Stretch="Uniform" Height="50" Width="18"/>
                        </StackPanel>

                        <!-- Lane B40 -->
                        <Button x:Name="btnLaneB40" 
                                Content="Lane B40" 
                                Background="White" 
                                Foreground="Black" 
                                FontWeight="Bold" 
                                Height="32"
                                BorderBrush="Green" 
                                BorderThickness="1.5"
                                Click="Lane_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
