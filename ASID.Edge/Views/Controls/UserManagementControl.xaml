<UserControl x:Class="ASID.Edge.Views.Controls.UserManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
            <TextBlock Text="👤 USER MANAGEMENT" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Add User Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Add New User" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtNewUsername" Margin="0,0,15,0" Padding="5"/>
                    <TextBlock Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <PasswordBox Grid.Column="3" x:Name="TxtNewPassword" Margin="0,0,15,0" Padding="5"/>
                    <TextBlock Grid.Column="4" Text="Role:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Grid.Column="5" x:Name="CboNewRole" Margin="0,0,15,0" Padding="5" Width="120">
                        <ComboBoxItem Content="Operator" Tag="operator"/>
                        <ComboBoxItem Content="QA" Tag="qa"/>
                        <ComboBoxItem Content="Supervisor" Tag="supervisor"/>
                        <ComboBoxItem Content="Planner" Tag="planner"/>
                    </ComboBox>
                    <Button Grid.Column="6" Content="+ Add User" Click="AddUser_Click"
                            Background="#2E7D32" Foreground="White" FontWeight="SemiBold"
                            Padding="15,5" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- User Table -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10"
                BorderBrush="#E0E0E0" BorderThickness="1">                <DataGrid x:Name="UserGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" AlternatingRowBackground="#F8F9FA"
                      SelectionMode="Single" CanUserAddRows="False"
                      CanUserResizeColumns="True" ColumnHeaderHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="✏ Edit Selected" Click="EditUser_Click"
                    Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                    Padding="15,5" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="🗑 Delete Selected" Click="DeleteUser_Click"
                    Background="#C62828" Foreground="White" FontWeight="SemiBold"
                    Padding="15,5" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="🔄 Refresh" Click="Refresh_Click"
                    Background="#616161" Foreground="White" FontWeight="SemiBold"
                    Padding="15,5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
