<UserControl x:Class="ASID.Edge.Views.Controls.TransactionHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             d:Background="LightGray">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->

            <RowDefinition Height="Auto"/>
            <!-- Sort & Action Buttons -->

            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->

            <RowDefinition Height="*"/>
            <!-- Data Grid -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Background="#0B3A66"
                Padding="8">
            <TextBlock Text="PU SUPERMARKET TRANSACTION HISTORY"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="15"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ================= TOOLBAR ================= -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT : Sort Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Click="OnSortByModelClick"
                        Margin="5"
                        Padding="10,5"
                        Background="#E0E0E0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Model"/>
                        <TextBlock Text=" ▲▼"/>
                    </StackPanel>
                </Button>

                <Button Click="OnSortByDateClick"
                        Margin="5"
                        Padding="10,5"
                        Background="#E0E0E0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Date"/>
                        <TextBlock Text=" ▲▼"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- RIGHT : Suspected NC & QA Review Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="NonConformance"
                        Click="NonConformance_Click"
                        Margin="5"
                        Padding="12,5"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ " FontSize="14"/>
                        <TextBlock Text="Suspected NC"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QAReview"
                        Click="QAReview_Click"
                        Margin="5"
                        Padding="12,5"
                        Background="#0B3A66"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " FontSize="14"/>
                        <TextBlock Text="QA Review NC"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="2"
                Margin="5"
                Padding="6"
                BorderBrush="#CFCFCF"
                BorderThickness="1"
                Background="#F5F5F5">
            <DockPanel>
                <TextBlock Text="Records : " FontWeight="Bold"/>
                <TextBlock x:Name="TxtRecordCount" Text="0"/>

                <TextBlock Margin="25,0,0,0" Text="Last Refresh : " FontWeight="Bold"/>
                <TextBlock x:Name="TxtLastRefresh" Text="--"/>
            </DockPanel>
        </Border>

        <!-- ================= TRANSACTION GRID ================= -->
        <DataGrid x:Name="TransactionGrid"
                  Grid.Row="3"
                  Margin="5"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowBackground="White"
                  AlternatingRowBackground="#EAEAEA"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  d:ItemsSource="{d:SampleData ItemCount=10}">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Confirmed NC Highlight in Red -->
                        <DataTrigger Binding="{Binding IsNCConfirmed}" Value="True">
                            <Setter Property="Background" Value="#FFCDD2"/>
                            <Setter Property="Foreground" Value="#B71C1C"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>

                        <!-- Suspected NC Highlight in Yellow/Orange -->
                        <DataTrigger Binding="{Binding IsSuspectedNC}" Value="True">
                            <Setter Property="Background" Value="#FFF9C4"/>
                            <Setter Property="Foreground" Value="#E65100"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Remarks / NC" Binding="{Binding NCRemarks}" Width="120"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Part No" Binding="{Binding PartNo}" Width="*"/>
                <DataGridTextColumn Header="Serial No" Binding="{Binding SerialNo}" Width="*"/>
                <DataGridTextColumn Header="SNP" Binding="{Binding SNP}" Width="*"/>
                <DataGridTextColumn Header="Line No" Binding="{Binding LineNo}" Width="*"/>
                <DataGridTextColumn Header="Trolley No" Binding="{Binding TrolleyNo}" Width="*"/>
                <DataGridTextColumn Header="Lane No" Binding="{Binding LaneNo}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>