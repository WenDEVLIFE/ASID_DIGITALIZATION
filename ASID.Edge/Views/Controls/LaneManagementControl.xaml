<UserControl x:Class="ASID.Edge.Views.Controls.LaneManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" Padding="12,10">
            <TextBlock Text="LANE MANAGEMENT" Foreground="White" FontWeight="Bold" FontSize="18"/>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Supervisor Access Only" 
                       Foreground="#E74C3C" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,15,0"/>

            <TextBlock Grid.Column="2" x:Name="txtRecordCount" Text="Records: 0"
                       Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Margin="10,5" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <DataGrid x:Name="dgLanes"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E0E0E0"
                      VerticalGridLinesBrush="#E0E0E0"
                      AlternatingRowBackground="#F8F9FA"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lane No." Binding="{Binding LaneNo}" IsReadOnly="True" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNo}" IsReadOnly="True" Width="120"/>

                    <DataGridTextColumn Header="Max Qty Stored" Binding="{Binding MaxQtyStored}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Actual Stored Qty" Binding="{Binding ActualStoredQty}" IsReadOnly="True" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Withdrawn Qty" Binding="{Binding WithdrawnQty}" IsReadOnly="True" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Outstanding Qty" Binding="{Binding OutstandingQty}" IsReadOnly="True" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Lane Status" Binding="{Binding LaneStatus}" IsReadOnly="True" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Color" Binding="{Binding ColorStatus}" IsReadOnly="True" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10">
            <Button x:Name="btnSave" Content="Save Changes" Width="120" Height="32"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click" Margin="5"/>
            <Button x:Name="btnRefresh" Content="Refresh" Width="100" Height="32"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    Click="BtnRefresh_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>
