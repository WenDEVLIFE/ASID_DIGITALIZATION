<UserControl x:Class="ASID.Edge.Views.Controls.LaneManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" Padding="12,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="LANE MANAGEMENT" Foreground="White" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="Click Edit or Delete on any row" 
                               Foreground="#B0C4DE" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="📋 Qty = Trolley Count (each scan = 1 trolley) | SNP = Items per trolley (inside the trolley)"
                           Foreground="#AED6F1" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="⚠ Supervisor Access Only" 
                       Foreground="#E74C3C" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,15,0"/>

            <TextBlock Grid.Column="2" x:Name="txtRecordCount" Text="Records: 0"
                       Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Margin="10,5" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <DataGrid x:Name="dgLanes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E0E0E0"
                      VerticalGridLinesBrush="#E0E0E0"
                      AlternatingRowBackground="#F8F9FA"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      FontSize="12"
                      CanUserResizeColumns="True"
                      ColumnHeaderHeight="30">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="Width" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MaxWidth" Value="0"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Lane No -->
                    <DataGridTextColumn Header="Lane No." Binding="{Binding LaneNo, Mode=OneWay}" Width="*" MaxWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Part Number -->
                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNo, Mode=OneWay}" Width="*"/>

                    <!-- Max Trolleys -->
                    <DataGridTextColumn Header="Max Trolleys" Binding="{Binding MaxQtyStored, Mode=OneWay}" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Actual Stored -->
                    <DataGridTextColumn Header="Stored (Scans)" Binding="{Binding ActualStoredQty, Mode=OneWay}" Width="*" MaxWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Withdrawn -->
                    <DataGridTextColumn Header="Withdrawn" Binding="{Binding WithdrawnQty, Mode=OneWay}" Width="*" MaxWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Balance -->
                    <DataGridTextColumn Header="Balance" Binding="{Binding OutstandingQty, Mode=OneWay}" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTextColumn Header="Status" Binding="{Binding LaneStatus, Mode=OneWay}" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Color -->
                    <DataGridTextColumn Header="Color" Binding="{Binding ColorStatus, Mode=OneWay}" Width="*" MaxWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Action (LAST COLUMN) -->
                    <DataGridTemplateColumn Header="Action" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Edit"
                                            Tag="{Binding}"
                                            Click="BtnEditLane_Click"
                                            Background="#3498DB" Foreground="White"
                                            FontWeight="Bold" FontSize="10"
                                            Padding="8,3" Cursor="Hand"
                                            BorderThickness="0" Margin="0,0,5,0"/>
                                    <Button Content="🗑️ Delete"
                                            Tag="{Binding}"
                                            Click="BtnDeleteLane_Click"
                                            Background="#E74C3C" Foreground="White"
                                            FontWeight="Bold" FontSize="10"
                                            Padding="8,3" Cursor="Hand"
                                            BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10">
            <Button x:Name="btnSave" Content="💾 Save All" Width="120" Height="32"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click" Margin="5" Cursor="Hand"/>
            <Button x:Name="btnRefresh" Content="🔄 Refresh" Width="100" Height="32"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    Click="BtnRefresh_Click" Margin="5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
