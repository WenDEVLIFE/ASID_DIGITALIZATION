<UserControl x:Class="ASID.Edge.Views.Controls.LaneManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0B3A66" Padding="12,10">
            <Grid>
                <TextBlock Text="LANE MANAGEMENT" Foreground="White" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="💡 Double-click a cell to edit. Click Save when done." 
                           Foreground="#B0C4DE" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="⚠ Supervisor Access Only" 
                       Foreground="#E74C3C" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,15,0"/>

            <TextBlock Grid.Column="2" x:Name="txtRecordCount" Text="Records: 0"
                       Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Margin="10,5" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <DataGrid x:Name="dgLanes"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E0E0E0"
                      VerticalGridLinesBrush="#E0E0E0"
                      AlternatingRowBackground="#F8F9FA"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      FontSize="12"
                      CanUserResizeColumns="True"
                      ColumnHeaderHeight="30">
                <DataGrid.Resources>
                    <!-- Kill row header gap completely -->
                    <Style TargetType="{x:Type DataGridRowHeader}">
                        <Setter Property="Width" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MaxWidth" Value="0"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Lane No - Read Only -->
                    <DataGridTextColumn Header="Lane No." Binding="{Binding LaneNo, Mode=OneWay}" IsReadOnly="True" Width="*" MaxWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Part Number - EDITABLE -->
                    <DataGridTextColumn Header="Part Number ✏️" Binding="{Binding PartNo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>

                    <!-- Max Qty Stored - EDITABLE -->
                    <DataGridTextColumn Header="Max Qty ✏️" Binding="{Binding MaxQtyStored, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Actual Stored Qty - EDITABLE -->
                    <DataGridTextColumn Header="Stored Qty ✏️" Binding="{Binding ActualStoredQty, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" MaxWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Withdrawn Qty - EDITABLE -->
                    <DataGridTextColumn Header="Withdrawn ✏️" Binding="{Binding WithdrawnQty, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" MaxWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Outstanding Qty - Read Only (calculated) -->
                    <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingQty, Mode=OneWay}" IsReadOnly="True" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Lane Status - Read Only -->
                    <DataGridTextColumn Header="Status" Binding="{Binding LaneStatus, Mode=OneWay}" IsReadOnly="True" Width="*" MaxWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Color Status - Read Only -->
                    <DataGridTextColumn Header="Color" Binding="{Binding ColorStatus, Mode=OneWay}" IsReadOnly="True" Width="*" MaxWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10">
            <Button x:Name="btnSave" Content="💾 Save Changes" Width="130" Height="32"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click" Margin="5"/>
            <Button x:Name="btnRefresh" Content="🔄 Refresh" Width="100" Height="32"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    Click="BtnRefresh_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>
