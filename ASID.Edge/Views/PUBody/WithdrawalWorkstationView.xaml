<UserControl x:Class="ASID.Edge.Views.PUBody.WithdrawalWorkStationView"
        xmlns:controls="clr-namespace:ASID.Edge.Views.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ASID.Edge.Views.PUBody"
        mc:Ignorable="d">
    <!--Title="PU Body Supermarket Inventory" Height="500" Width="900"-->

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL ================= -->
        <Border Grid.Column="0"
        BorderBrush="Black"
        BorderThickness="1"
        Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Login Portal -->

                    <RowDefinition Height="*"/>
                    <!-- Spacer -->

                    <RowDefinition Height="Auto"/>
                    <!-- Workflow Status -->
                </Grid.RowDefinitions>

                <!--Supermarket withdrawal portal-->
                <controls:WithdrawalPortalControl
                    Grid.Row="0"
                    x:Name ="WithdrawalPortal"/>

                <!-- Spacer -->
                <Grid Grid.Row="1"/>

                <!-- Workflow Status -->
                <controls:WorkflowStatusControl
            Grid.Row="2"
            x:Name="WorkflowStatus"/>

            </Grid>

        </Border>

        <!-- ================= RIGHT PANEL ================= -->
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- Transaction History -->
                <controls:TransactionHistoryControl 
                    x:Name="TransactionHistory"
                    Grid.Row="0"
                    Margin="0,0,0,8"/>

                <!-- Inventory + Withdrawal -->
                <Grid Grid.Row="1"
          Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <controls:InventoryControl
                        x:Name="Inventory"
                        Grid.Column="0"
                        Margin="0,0,5,0"/>

                    <controls:WithdrawalControl
                        x:Name="Withdrawal"
                        Grid.Column="1"
                        Margin="5,0,0,0"/>

                </Grid>

                <!-- Daily Demand -->
                <controls:DailyDemandControl 
                    x:Name="DailyDemand"
                    Grid.Row="2"/>

            </Grid>

        </Border>

    </Grid>

    </UserControl>

