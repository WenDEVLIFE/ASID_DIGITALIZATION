<Window x:Class="ASID.Edge.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASID Edge — Login"
        Width="420"
        Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="ASID EDGE"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#0B3A66"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="Sign in to continue"
                   FontSize="13"
                   Foreground="#666666"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,16"/>

        <!-- Username -->
        <TextBlock Grid.Row="2"
                   Text="Username"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameTextBox"
                 Grid.Row="3"
                 Height="38"
                 FontSize="15"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 KeyDown="UsernameTextBox_KeyDown"/>

        <!-- Password -->
        <TextBlock Grid.Row="4"
                   Text="Password"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordInput"
                     Grid.Row="5"
                     Height="38"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     KeyDown="PasswordInput_KeyDown"/>

        <!-- Error -->
        <TextBlock x:Name="ErrorText"
                   Grid.Row="6"
                   Text=""
                   Foreground="#B71C1C"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,2,0,4"/>

        <!-- Actions -->
        <DockPanel Grid.Row="7" Margin="0,8,0,0">
            <Button Content="Cancel"
                    Width="90"
                    Height="34"
                    DockPanel.Dock="Left"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Login"
                    Width="120"
                    Height="34"
                    Background="#0B3A66"
                    Foreground="White"
                    FontWeight="Bold"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="Submit_Click"/>
        </DockPanel>
    </Grid>
</Window>
