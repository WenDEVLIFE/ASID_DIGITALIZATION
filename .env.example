# ============================================================================
# ASID database configuration (template)
# ============================================================================
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#
# Two connection profiles are supported, selected by ASID_USE_LOCAL:
#   ASID_USE_LOCAL=true  -> uses the ASID_LOCAL_DB_* variables (localhost)
#   ASID_USE_LOCAL=false -> uses the ASID_DB_* variables (cloud / Neon)
# ============================================================================

# --- Toggle ---------------------------------------------------------------
ASID_USE_LOCAL=true

# --- LOCAL (PostgreSQL on localhost) ---------------------------------------
ASID_LOCAL_DB_HOST=localhost
ASID_LOCAL_DB_PORT=5432
ASID_LOCAL_DB_NAME=asid_db
ASID_LOCAL_DB_USER=postgres
ASID_LOCAL_DB_PASSWORD=your-local-password

# --- CLOUD (Neon) ----------------------------------------------------------
# Uncomment these (and set ASID_USE_LOCAL=false) to use the cloud database.
# ASID_DB_HOST=your-neon-host
# ASID_DB_PORT=5432
# ASID_DB_NAME=asid_db
# ASID_DB_USER=your-neon-user
# ASID_DB_PASSWORD=your-neon-password
