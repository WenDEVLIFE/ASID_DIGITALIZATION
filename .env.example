# ============================================================================
# ASID database configuration (template)
# ============================================================================
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#
# Database engine selection:
#   ASID_DB_ENGINE=postgresql  -> uses PostgreSQL
#   ASID_DB_ENGINE=mssql       -> uses Microsoft SQL Server
# ============================================================================

# --- Database Engine -------------------------------------------------------
ASID_DB_ENGINE=mssql

# --- MSSQL Server (client's on-prem server) --------------------------------
ASID_MSSQL_SERVER=AZP-SQ01\p01
ASID_MSSQL_DB=asid32_db
ASID_MSSQL_USER=eondb_dbo
ASID_MSSQL_PASSWORD=xuVLa!P4BT5A!Lgwf91b

# --- LOCAL (PostgreSQL on localhost) ----------------------------------------
